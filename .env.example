# Optional server-only settings. Use a production mainnet RPC with owner-index queries.
# SOLANA_RPC_URL=https://your-mainnet-rpc-provider.example/
# SOLANA_WALLET_RPC_URL=https://your-mainnet-wallet-rpc-provider.example/
# JUPITER_API_KEY=

# Dedicated disposable Devnet authority only; NEVER the program upgrade key.
# STOCKROOM_DEMO_AUTHORITY=[64 secret-key bytes, stored as a server-only secret]

# Pyth Pro API key for dollar-denominated launch targets (server-only; never expose to the browser).
# Free: sign up at https://pythdata.app and click "View your API key". Without it, launches use mSPY targets.
# PYTH_PRO_API_KEY=

# Image storage (S3 behind CloudFront). Not used by the app yet; planned for token images.
# The IAM user needs only s3:PutObject on <bucket>/tokens/*. Keys are server-only secrets.
# AWS_REGION=ap-southeast-1
# SONATA_ASSETS_BUCKET=sonata-devnet-assets
# SONATA_ASSETS_CDN=https://<distribution>.cloudfront.net
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
