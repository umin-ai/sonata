# Sonata trade indexer: Devnet DBC swaps into local PostgreSQL, a read-only
# market-data API on 127.0.0.1:8790 (Caddy serves it at /api/index/*), and,
# with LIVE_PUSH=1 in indexer.env, live market updates at /api/index/stream.
[Unit]
Description=Sonata trade indexer (Solana Devnet)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=sonata
Group=sonata
WorkingDirectory=/opt/sonata/app/web
EnvironmentFile=/opt/sonata/indexer.env
# Optional overrides, read last and never rewritten by setup.sh: SOLANA_RPC_URL
# (the indexer's own Devnet RPC; default public Devnet).
EnvironmentFile=-/opt/sonata/indexer-overrides.env
# Type stripping lets live push decode markets with the app's own TypeScript
# (lib/treasury/snapshot-decode.ts); without it the indexer runs without live push.
ExecStart=/usr/bin/node --experimental-strip-types --no-warnings indexer/index.mjs
Restart=always
RestartSec=5
# Each open live stream holds one connection from Caddy.
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
