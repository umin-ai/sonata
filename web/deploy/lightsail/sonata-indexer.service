# Sonata trade indexer: Devnet DBC swaps into local PostgreSQL, and a read-only
# market-data API on 127.0.0.1:8790 (Caddy serves it at /api/index/*).
[Unit]
Description=Sonata trade indexer (Solana Devnet)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=sonata
Group=sonata
WorkingDirectory=/opt/sonata/app/web
EnvironmentFile=/opt/sonata/indexer.env
# Optional overrides, read last and never rewritten by setup.sh: SOLANA_RPC_URL
# (the indexer's own Devnet RPC; default public Devnet).
EnvironmentFile=-/opt/sonata/indexer-overrides.env
ExecStart=/usr/bin/node indexer/index.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
