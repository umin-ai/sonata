# Sonata creator payout crank: one pass of permissionless claim + distribute
# over every Sonata market on Solana Devnet, then reward token payouts, then
# exit. Started every 15 minutes by sonata-crank.timer. For ordinary markets its
# key only pays network fees (and rent for a missing payout token account);
# every destination is pinned onchain. For Reward token markets (payout owner =
# this key) it receives the creator share and pays it on to the token's holders.
[Unit]
Description=Sonata creator payout crank (Solana Devnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sonata
Group=sonata
WorkingDirectory=/opt/sonata/app/web
Environment=CRANK_KEYPAIR=/opt/sonata/crank-keypair.json
# DATABASE_URL for the reward ledger, shared with sonata-indexer (written by
# setup.sh). Without it reward payouts are skipped; claims still run.
EnvironmentFile=-/opt/sonata/indexer.env
# Optional overrides, read last: SOLANA_RPC_URL, CRANK_MIN_ATOMS,
# REWARD_MIN_ATOMS, CRANK_DRY_RUN=1.
EnvironmentFile=-/opt/sonata/crank.env
ExecStart=/usr/bin/node indexer/crank.mjs
# A stuck pass must end so the timer can start the next one.
TimeoutStartSec=10min
NoNewPrivileges=true
# The crank writes nothing to disk (the ledger is PostgreSQL over 127.0.0.1),
# so no ReadWritePaths are needed.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
