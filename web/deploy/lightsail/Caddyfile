# HTTPS with an automatic Let's Encrypt certificate, then proxy to the app.
__HOST__ {
	# The app never trusts these, but strip them at the edge as well.
	request_header -Oai-Authenticated-User-Id
	request_header -Oai-Authenticated-User-Email
	request_header -Oai-Authenticated-User-Full-Name
	request_header -Oai-Authenticated-User-Full-Name-Encoding
	request_body {
		max_size 200KB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Live market updates from the trade indexer (Server-Sent Events). Outside
	# `encode`: the stream is written once for every client, not compressed per
	# client. reverse_proxy flushes text/event-stream responses at once; no
	# flush_interval -1, which would keep the indexer's side open after the
	# browser leaves.
	handle /api/index/stream {
		reverse_proxy 127.0.0.1:8790
	}
	handle {
		encode zstd gzip
		# Read-only market data from the trade indexer.
		handle /api/index/* {
			reverse_proxy 127.0.0.1:8790
		}
		handle {
			reverse_proxy 127.0.0.1:8787
		}
	}
}
