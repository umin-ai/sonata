# Runs the Sonata build in Cloudflare's workerd runtime (wrangler local mode),
# listening only on 127.0.0.1 behind Caddy. The app reads its public origin
# from --local-upstream/--upstream-protocol so its same-origin checks work.
[Unit]
Description=Sonata (Solana Devnet)
After=network-online.target
Wants=network-online.target

[Service]
User=sonata
Group=sonata
WorkingDirectory=/opt/sonata/app/web
Environment=NODE_ENV=production
Environment=SITES_RUNTIME_ROOT=/opt/sonata/runtime
ExecStart=/usr/bin/node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to /opt/sonata/state --ip 127.0.0.1 --port 8787 --inspector-port 0 --local-upstream __HOST__ --upstream-protocol https --show-interactive-dev-session=false
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
