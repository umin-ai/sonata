# Optional server-only settings.
# Read-only mainnet RPC for the mainnet xStock pool list (app/api/mainnet-pools).
# Without it the app uses public mainnet endpoints.
# SOLANA_MAINNET_RPC_URL=https://your-mainnet-rpc-provider.example/
# Jupiter API key for stock prices (app/api/stock-price). Without it the app uses Jupiter's keyless API.
# JUPITER_API_KEY=

# Pyth Pro API key for dollar-denominated launch targets (server-only; never expose to the browser).
# Free: sign up at https://pythdata.app and click "View your API key". Without it, launches use mSPY targets.
# PYTH_PRO_API_KEY=

# Token image and metadata storage for app/api/token-profile (S3 behind CloudFront).
# Without these settings uploads fall back to Irys devnet, which is temporary.
# The IAM user needs only s3:PutObject on <bucket>/tokens/*. Keys are server-only secrets.
# AWS_REGION=eu-west-1
# SONATA_ASSETS_BUCKET=sonata-devnet-assets
# SONATA_ASSETS_CDN=https://<distribution>.cloudfront.net
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Trade indexer API for charts and recent trades, and (its /accounts) for the
# server-rendered market list and market pages. Local development defaults to
# the hosted indexer (https://sonata.umin.ai/api/index); the server uses its own.
# INDEXER_URL=http://127.0.0.1:8790/api/index
# Another source for the market accounts, e.g. scripts/dev-market-accounts.mjs
# run locally. Defaults to $INDEXER_URL/accounts.
# MARKET_ACCOUNTS_URL=http://127.0.0.1:8793/api/index/accounts

# Fallback Devnet RPCs for app/api/rpc (server-only), tried in this order when
# Solana's public endpoint is busy: each endpoint's full HTTPS URL, which
# includes its access token. Without them the app uses the public endpoint only.
# QUICKNODE_DEVNET_URL=https://<name>.solana-devnet.quiknode.pro/<token>/
# GETBLOCK_DEVNET_URL=https://<region>.getblock.io/<token>/

# Second Devnet RPC for the indexer's live poll (server-only): the poll alternates
# between public Devnet and this endpoint, so it can run every second within both
# free plans. Without it the poll uses public Devnet alone, every 2 seconds.
# CHAINSTACK_DEVNET_URL=https://solana-devnet.core.chainstack.com/<token>
